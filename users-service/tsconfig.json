{
	"$schema": "https://www.schemastore.org/tsconfig",
	"display": "Node 24",
	"_version": "24.0.0",

	"compilerOptions": {
		"lib": ["es2024"],
		"module": "nodenext",
		"target": "es2024",
		"types": ["node"],

		"rootDir": "./",
		"outDir": "./dist",

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "node16",

		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	}
}
