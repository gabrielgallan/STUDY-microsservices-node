# Environment
NODE_ENV="development"
PORT=3004

# Secrets
JWT_SECRET="your-jwt-secret"

# Database
DATABASE_URL="postgresql://docker:docker@localhost:5434/payments"

# Services
USERS_SERVICE_URL="http://localhost:3001"
PRODUCTS_SERVICE_URL="http://localhost:3002"
CHECKOUT_SERVICE_URL="http://localhost:3003"

# RabbitMQ
RABBITMQ_URL="amqp://admin:admin@localhost:5672"
RABBITMQ_QUEUE_PAYMENTS="payment_queue"
RABBITMQ_EXCHANGE="payments"

# API's
PAYMENT_GATEWAY_URL=""
PAYMENT_GATEWAY_API_KEY=""